# Gmail with App Password (no Google Cloud needed)
# 1. Enable 2FA on the throwaway Gmail
# 2. Go to Google Account > Security > App Passwords > generate one
EMAIL_ADDRESS=your-throwaway@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated list of report recipients (can be any email addresses)
REPORT_RECIPIENTS=you@gmail.com,wife@gmail.com

# rclone setup:
#   rclone config -> new remote named "homesearch" -> type "drive" -> authorize with throwaway Gmail
# For GitHub Actions secret RCLONE_CONFIG_B64:
#   rclone config show homesearch | base64
